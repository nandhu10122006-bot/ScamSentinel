# TrustLens-AI Backend Environment Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Google Web Risk Lookup API Key (Leave blank if not configured)
# Official documentation: https://docs.cloud.google.com/web-risk/docs/lookup-api
GOOGLE_WEB_RISK_API_KEY=

# Optional legacy/alternative threat intelligence keys
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
