APP_ENV=development
# Empty uses SQLite only in development/test; all other environments require a PostgreSQL DSN.
DATABASE_URL=
# Required for scan and stored-history API access when APP_ENV is production. Never commit a real value.
CYBERSENTRY_ACCESS_TOKEN=
# Required to authorize the protected feed-sync API endpoint.
CYBERSENTRY_ADMIN_TOKEN=
# Comma-separated exact origins; blank disables cross-origin access.
TRUSTED_ORIGINS=

# URLhaus community data requires an Auth-Key and permitted use. Commercial use may require paid access.
URLHAUS_AUTH_KEY=
URLHAUS_USAGE=disabled
# Google Safe Browsing is non-commercial only. Commercial use should use Web Risk.
GOOGLE_SAFE_BROWSING_API_KEY=
GOOGLE_SAFE_BROWSING_USAGE=disabled
# Public VirusTotal is non-commercial and rate-limited; commercial use requires a suitable Premium license.
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_USAGE=disabled

URL_SCAN_PROVIDER_TIMEOUT_SECONDS=6
AUTO_FEED_SYNC=false
FEED_SYNC_INTERVAL_HOURS=24
RETENTION_DAYS=90
MAX_UPLOAD_BYTES=8388608
RATE_LIMIT_API_REQUESTS_PER_MINUTE=120
RATE_LIMIT_SCANS_PER_MINUTE=12
RATE_LIMIT_QR_PER_MINUTE=6
# Optional JSON object overrides supported finding-code weights (integers 0-100).
RISK_WEIGHTS_JSON=

